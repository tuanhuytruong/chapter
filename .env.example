# ============================================================================
# Chapter — AI Daily Book Reading Companion · environment template
# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
# (`.env.local` is git-ignored; `.env.example` is committed as a template)
# ============================================================================

# --- Database (PostgreSQL on e7240ubt, schema `chapter` in `dwh`) ----------
# REQUIRED. If missing, the app serves 503 "DB unavailable" on /api/books.
# If your password contains special chars (@ # / : $ % +), URL-encode them,
# e.g.  p@ss#word  ->  p%40ss%23word
DATABASE_URL=postgresql://dwh:***@localhost:5432/dwh

# --- LLM (9router OpenAI-compatible endpoint on e7240ubt) -------------------
NINE_ROUTER_URL=http://localhost:20128/v1/chat/completions
NINE_ROUTER_MODEL=n8n
NINE_ROUTER_API_KEY=***
# Provider safety envelope: request starts are evenly spaced at 5/sec by default,
# independent from up to 30 simultaneous upstream calls. Keep the RPS cap at 5
# unless the provider explicitly raises it; raise concurrency toward 50 only after
# production timeout/error monitoring is stable.
NINE_ROUTER_MAX_RPS=5
NINE_ROUTER_MAX_CONCURRENCY=30
# Read Today stays bounded separately. AI Reader has a longer configurable
# provider window because structured batch output may be queued upstream.
NINE_ROUTER_INTERACTIVE_TIMEOUT_MS=25000
NINE_ROUTER_TIMEOUT_MS=60000
NINE_ROUTER_AI_READER_TIMEOUT_MS=360000

# --- Podcast (private Telegram archive; web playback only) ------------------
# Required for Podcast production. Archive chat must be private and allow the bot
# to post audio. Never expose its ID or the bot token to browser code.
PODCAST_TELEGRAM_ARCHIVE_CHAT_ID=-1000000000000
PODCAST_CACHE_DIR=/opt/chapter/workspace/podcast-cache
PODCAST_CACHE_TTL_HOURS=48
PODCAST_LLM_MODEL=gemini-2.5-flash
PODCAST_TTS_URL=https://9router-ubt.mrl.asia/v1/audio/speech
PODCAST_TTS_MAX_CHARS=12000

# --- Telegram delivery (n8n cron pushes summaries here) --------------------
TELEGRAM_BOT_TOKEN=***          # from @BotFather
TELEGRAM_CHAT_ID=***            # numeric chat id (no -100 prefix for PM)

# --- Authentication / sessions ------------------------------------------------
# REQUIRED in production: generate with `openssl rand -base64 48`.
SESSION_SECRET=replace-with-a-long-random-secret
# Reserved for administrative operations; use a distinct randomly generated value.
ADMIN_TOKEN=replace-with-a-separate-random-token
# Existing account that receives a deleted user's books.
ADMIN_USERNAME=admin

# --- Identity & password recovery ------------------------------------------
# Canonical public origin, no trailing slash.
APP_URL=https://chapter.mrl.asia
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# Server-only key from Resend. Never expose or commit a real value.
RESEND_API_KEY=re_replace-me
RESEND_FROM="Chapter <no-reply@account.mrl.asia>"
PASSWORD_RESET_TTL_MINUTES=45

# --- Release environment ----------------------------------------------------
# Each deployed folder owns one fixed identity. Do not point both folders at the
# same books/cache directory, and do not reuse SESSION_SECRET across environments.
# Production (/opt/chapter): APP_ENV=prd, CHAPTER_BRANCH=master,
#   CHAPTER_PM2_NAME=chapter-prd, PORT=3000
# Development (/opt/chapter-dev): APP_ENV=dev, CHAPTER_BRANCH=dev,
#   CHAPTER_PM2_NAME=chapter-dev, PORT=3001
APP_ENV=prd
CHAPTER_BRANCH=master
CHAPTER_PM2_NAME=chapter-prd
PORT=3000
CHAPTER_BOOKS_DIR=/opt/chapter/workspace/books
